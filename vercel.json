{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "admin/package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } }
  ],
  "routes": [
    { "src": "/api/whatsapp/(.*)", "dest": "api/index.js" },
    { "src": "/api/(.*)", "dest": "api/index.js" },
    { "src": "/webhook", "dest": "api/index.js" },
    { "src": "/driver", "dest": "api/index.js" },
    { "src": "/(.*)", "dest": "admin/$1", "check": true }
  ]
}
